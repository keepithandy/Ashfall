extends SceneTree
## Ashfall 2.3: live survival, world, weathered UI and responsive layout.
## Run: godot --headless --path . --script res://tests/check_station_23.gd

func _initialize() -> void:
    call_deferred("_run")


func _run() -> void:
    var errors: Array[String] = []
    var packed := load("res://scenes/ashfall_station_main.tscn") as PackedScene
    if packed == null:
        push_error("Station 04 scene unavailable")
        quit(1)
        return
    var game := packed.instantiate()
    root.add_child(game)
    await process_frame
    var hud := game.get("hud") as Control
    var player := game.get("player") as CharacterBody3D
    var rules := game.get("survival_rules") as Node
    var scene_sets := game.get_node_or_null("AbandonedLife23") as Node3D
    if player == null or hud == null:
        errors.append("Missing player or live HUD")
    if scene_sets == null:
        errors.append("New station environmental story dressing missing")
    else:
        if int(scene_sets.get("placed_count")) != 16:
            errors.append("All sixteen curated world props did not load")
        var trace_root := scene_sets.get_node_or_null("StorySets") as Node3D
        if trace_root == null or trace_root.get_child_count() != 16:
            errors.append("Story-set root missing or partial")
        else:
            for object in trace_root.find_children("*", "CollisionObject3D", true, false):
                var collider := object as CollisionObject3D
                if collider.collision_layer != 0 or collider.collision_mask != 0:
                    errors.append("Story scenery unexpectedly changes path collision")
                    break
            for position in scene_sets.get("placed_positions"):
                if absf(position.x) > 79.0 or absf(position.z) > 79.0:
                    errors.append("World story prop exceeds authored border")
                    break
        scene_sets.call("rebuild")
        if int(scene_sets.get("placed_count")) != 16:
            errors.append("World story sets rebuilt twice or disappeared")

    if rules == null:
        errors.append("Area-specific survival rules missing")
    else:
        var old_index := int(rules.get("selected").get("perimeter", 1))
        var old_hard := bool(rules.get("hardcore").get("perimeter", false))
        rules.call("set_tier", "perimeter", 1)
        rules.call("set_hardcore", "perimeter", false)
        if not is_equal_approx(float(rules.call("incoming_damage_factor")), 1.0) or not is_equal_approx(float(rules.call("stamina_cost_factor")), 1.0):
            errors.append("Grounded difficulty no longer preserves original movement/combat math")
        rules.call("set_tier", "perimeter", 0)
        if float(rules.call("incoming_damage_factor")) >= 1.0:
            errors.append("Light setting does not reduce damage")
        rules.call("set_tier", "perimeter", 2)
        if float(rules.call("stamina_cost_factor")) <= 1.0:
            errors.append("Brutal setting does not increase exertion")
        var before := float(rules.call("incoming_damage_factor"))
        rules.call("set_hardcore", "perimeter", true)
        if float(rules.call("incoming_damage_factor")) <= before:
            errors.append("Hardcore did not increase exposure")
        rules.call("set_hardcore", "perimeter", old_hard)
        rules.call("set_tier", "perimeter", old_index)

    if hud != null:
        if (hud.get("menu_title") as Label).text != "ASHFALL 2.3":
            errors.append("Old version appears on launch")
        var album := hud.get("field_record") as Control
        if album == null or album.get_node_or_null("WeatheredCanvas") == null:
            errors.append("Weathered expedition notebook cover missing")
        else:
            var paper := album.get_node_or_null("WeatheredCanvas/CenterContainer/WornNotebookCover/StainedPaper")
            # Find recursively because CenterContainer is generated by script.
            if paper == null:
                paper = album.find_child("StainedPaper", true, false)
            if paper == null or paper.find_child("Weathering", true, false) == null:
                errors.append("Field notebook does not have its scuffed paper surface")
            if album.get("unlocked").size() != 1:
                errors.append("Notebook already marked discoveries before starting")
            if album.get("content") == null:
                errors.append("Notebook pages missing")
            var places: Array = album.get("PLACES") if album.get("PLACES") != null else []
            if places.size() != 12:
                # Static constants are not always available through Object.get().
                var known = load("res://scripts/runtime/expedition_field_record.gd").get_script_constant_map()
                if not known.has("PLACES") or known["PLACES"].size() != 12:
                    errors.append("Expanded twelve-location survey entries missing")

        var pack := hud.get("inventory_screen") as Control
        if pack == null or pack.find_child("Weathering", true, false) == null:
            errors.append("Field pack lacks weathered paper treatment")
        elif pack.find_child("Slots", true, false).get_child_count() != 27:
            errors.append("New presentation broke the 27-slot inventory layout")

        hud.size = Vector2(960, 540)
        hud.call("_layout_hud")
        var sound := hud.get("audio_panel") as Control
        if sound == null or sound.find_child("Weathering", true, false) == null:
            errors.append("Audio settings do not share the survival theme")
        else:
            var slider := sound.get_node_or_null("MasterSlider") as HSlider
            var back := sound.get_node_or_null("SoundBack") as Button
            if slider == null or back == null or slider.position.x + slider.size.x > 930.0 or back.position.y + back.size.y > 540.0:
                errors.append("Sound controls clip the laptop viewport")
        if hud.get("intro_layout").size() != 3:
            errors.append("Start/exit/audio menu lost original controls")

    game.queue_free()
    await process_frame
    if errors.is_empty():
        print("ASHFALL 2.3 WEATHERED SURVIVAL REGRESSION PASSED")
        quit(0)
    else:
        for error in errors:
            push_error(error)
        print("ASHFALL 2.3 REGRESSION FAILED: ", errors.size(), " issues")
        quit(1)
